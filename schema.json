{
  "version": 8,
  "name": "prosperity_music_d1",
  "description": "Comprehensive Canonical Cloudflare D1 Database Schema for Prosperity Music",
  "tables": {
    "profiles": {
      "columns": {
        "id": "TEXT PRIMARY KEY",
        "username": "TEXT NOT NULL UNIQUE",
        "display_name": "TEXT",
        "bio": "TEXT DEFAULT ''",
        "avatar_url": "TEXT DEFAULT ''",
        "cover_url": "TEXT DEFAULT ''",
        "social_link1": "TEXT DEFAULT ''",
        "social_link2": "TEXT DEFAULT ''",
        "social_link3": "TEXT DEFAULT ''",
        "cloudflare_token": "TEXT DEFAULT ''",
        "worker_version": "TEXT DEFAULT '1.0.0'",
        "is_verified": "INTEGER DEFAULT 0",
        "created_at": "INTEGER DEFAULT (strftime('%s', 'now'))",
        "updated_at": "INTEGER DEFAULT (strftime('%s', 'now'))"
      },
      "indexes": [
        "CREATE INDEX IF NOT EXISTS idx_profiles_username ON profiles(username);"
      ]
    },
    "songs": {
      "columns": {
        "id": "TEXT PRIMARY KEY",
        "user_id": "TEXT NOT NULL REFERENCES profiles(id) ON DELETE CASCADE",
        "song_id": "TEXT NOT NULL",
        "song_title": "TEXT DEFAULT ''",
        "artist": "TEXT DEFAULT ''",
        "album": "TEXT DEFAULT ''",
        "art_url": "TEXT DEFAULT ''",
        "canvas_url": "TEXT DEFAULT ''",
        "duration": "INTEGER DEFAULT 0",
        "liked_at": "INTEGER DEFAULT (strftime('%s', 'now'))"
      },
      "constraints": [
        "UNIQUE(user_id, song_id)"
      ],
      "indexes": [
        "CREATE INDEX IF NOT EXISTS idx_songs_user_id ON songs(user_id);",
        "CREATE INDEX IF NOT EXISTS idx_songs_song_id ON songs(song_id);"
      ]
    },
    "albums": {
      "columns": {
        "id": "TEXT PRIMARY KEY",
        "user_id": "TEXT NOT NULL",
        "album_id": "TEXT NOT NULL",
        "title": "TEXT DEFAULT ''",
        "artist": "TEXT DEFAULT ''",
        "art_url": "TEXT DEFAULT ''",
        "added_at": "INTEGER DEFAULT (strftime('%s', 'now'))"
      },
      "constraints": [
        "UNIQUE(user_id, album_id)"
      ],
      "indexes": [
        "CREATE INDEX IF NOT EXISTS idx_albums_user_id ON albums(user_id);",
        "CREATE INDEX IF NOT EXISTS idx_albums_album_id ON albums(album_id);"
      ]
    },
    "playlists": {
      "columns": {
        "id": "TEXT PRIMARY KEY",
        "user_id": "TEXT NOT NULL",
        "owner_id": "TEXT DEFAULT ''",
        "owner_worker_url": "TEXT DEFAULT ''",
        "collaborator_workers": "TEXT DEFAULT ''",
        "title": "TEXT NOT NULL",
        "description": "TEXT DEFAULT ''",
        "cover_url": "TEXT DEFAULT ''",
        "type": "TEXT DEFAULT 'created'",
        "collab_role": "TEXT DEFAULT 'owner'",
        "collab_status": "TEXT DEFAULT 'accepted'",
        "invited_by": "TEXT DEFAULT ''",
        "template_id": "TEXT DEFAULT ''",
        "custom_title": "TEXT DEFAULT ''",
        "custom_subtitle": "TEXT DEFAULT ''",
        "sample_image_url": "TEXT DEFAULT ''",
        "primary_accent": "INTEGER DEFAULT 0",
        "gradient_colors": "TEXT DEFAULT ''",
        "is_public": "INTEGER DEFAULT 0",
        "created_at": "INTEGER DEFAULT (strftime('%s', 'now'))",
        "updated_at": "INTEGER DEFAULT (strftime('%s', 'now'))"
      },
      "constraints": [
        "UNIQUE(user_id, id)"
      ],
      "indexes": [
        "CREATE INDEX IF NOT EXISTS idx_playlists_user_id ON playlists(user_id);",
        "CREATE INDEX IF NOT EXISTS idx_playlists_owner_id ON playlists(owner_id);",
        "CREATE INDEX IF NOT EXISTS idx_playlists_type ON playlists(type);"
      ]
    },
    "playlist_tracks": {
      "columns": {
        "id": "TEXT PRIMARY KEY",
        "playlist_id": "TEXT NOT NULL",
        "song_id": "TEXT NOT NULL",
        "song_title": "TEXT DEFAULT ''",
        "artist": "TEXT DEFAULT ''",
        "album": "TEXT DEFAULT ''",
        "art_url": "TEXT DEFAULT ''",
        "canvas_url": "TEXT DEFAULT ''",
        "duration": "INTEGER DEFAULT 0",
        "position": "INTEGER DEFAULT 0",
        "added_at": "INTEGER DEFAULT (strftime('%s', 'now'))"
      },
      "constraints": [
        "UNIQUE(playlist_id, song_id)"
      ],
      "indexes": [
        "CREATE INDEX IF NOT EXISTS idx_playlist_tracks_playlist_id ON playlist_tracks(playlist_id);",
        "CREATE INDEX IF NOT EXISTS idx_playlist_tracks_song_id ON playlist_tracks(song_id);"
      ]
    },
    "listening_history": {
      "columns": {
        "id": "TEXT PRIMARY KEY",
        "user_id": "TEXT NOT NULL",
        "song_id": "TEXT NOT NULL",
        "song_title": "TEXT DEFAULT ''",
        "artist": "TEXT DEFAULT ''",
        "album": "TEXT DEFAULT ''",
        "art_url": "TEXT DEFAULT ''",
        "canvas_url": "TEXT DEFAULT ''",
        "played_at": "INTEGER DEFAULT (strftime('%s', 'now'))"
      },
      "indexes": [
        "CREATE INDEX IF NOT EXISTS idx_listening_history_user_id ON listening_history(user_id);",
        "CREATE INDEX IF NOT EXISTS idx_listening_history_played_at ON listening_history(played_at DESC);",
        "CREATE UNIQUE INDEX IF NOT EXISTS idx_listening_history_user_song ON listening_history(user_id, song_id);"
      ]
    },
    "podcast_history": {
      "columns": {
        "id": "TEXT PRIMARY KEY",
        "user_id": "TEXT NOT NULL",
        "episode_id": "TEXT NOT NULL",
        "show_id": "TEXT DEFAULT ''",
        "title": "TEXT DEFAULT ''",
        "position_ms": "INTEGER DEFAULT 0",
        "duration_ms": "INTEGER DEFAULT 0",
        "is_completed": "INTEGER DEFAULT 0",
        "updated_at": "INTEGER DEFAULT (strftime('%s', 'now'))"
      },
      "constraints": [
        "UNIQUE(user_id, episode_id)"
      ],
      "indexes": [
        "CREATE INDEX IF NOT EXISTS idx_podcast_history_user_id ON podcast_history(user_id);",
        "CREATE INDEX IF NOT EXISTS idx_podcast_history_episode_id ON podcast_history(episode_id);"
      ]
    },
    "search_history": {
      "columns": {
        "id": "TEXT PRIMARY KEY",
        "user_id": "TEXT NOT NULL",
        "query": "TEXT NOT NULL",
        "searched_at": "INTEGER DEFAULT (strftime('%s', 'now'))"
      },
      "indexes": [
        "CREATE INDEX IF NOT EXISTS idx_search_history_user_id ON search_history(user_id);",
        "CREATE INDEX IF NOT EXISTS idx_search_history_searched_at ON search_history(searched_at DESC);"
      ]
    },
    "user_blacklists": {
      "columns": {
        "id": "TEXT PRIMARY KEY",
        "user_id": "TEXT NOT NULL",
        "item_id": "TEXT NOT NULL",
        "item_type": "TEXT NOT NULL",
        "created_at": "INTEGER DEFAULT (strftime('%s', 'now'))"
      },
      "constraints": [
        "UNIQUE(user_id, item_id, item_type)"
      ],
      "indexes": [
        "CREATE INDEX IF NOT EXISTS idx_user_blacklists_user_id ON user_blacklists(user_id);"
      ]
    },
    "user_clips": {
      "columns": {
        "id": "TEXT PRIMARY KEY",
        "user_id": "TEXT NOT NULL",
        "song_id": "TEXT NOT NULL",
        "song_title": "TEXT DEFAULT ''",
        "artist": "TEXT DEFAULT ''",
        "art_url": "TEXT DEFAULT ''",
        "start_ms": "INTEGER NOT NULL DEFAULT 0",
        "end_ms": "INTEGER NOT NULL DEFAULT 30000",
        "duration_ms": "INTEGER NOT NULL DEFAULT 30000",
        "created_at": "INTEGER DEFAULT (strftime('%s', 'now'))"
      },
      "indexes": [
        "CREATE INDEX IF NOT EXISTS idx_user_clips_user_id ON user_clips(user_id);",
        "CREATE INDEX IF NOT EXISTS idx_user_clips_song_id ON user_clips(song_id);"
      ]
    },
    "user_downloads": {
      "columns": {
        "id": "TEXT PRIMARY KEY",
        "user_id": "TEXT NOT NULL",
        "song_id": "TEXT NOT NULL",
        "song_title": "TEXT DEFAULT ''",
        "artist": "TEXT DEFAULT ''",
        "album": "TEXT DEFAULT ''",
        "art_url": "TEXT DEFAULT ''",
        "duration": "INTEGER DEFAULT 0",
        "quality": "TEXT DEFAULT '320kbps'",
        "downloaded_at": "INTEGER DEFAULT (strftime('%s', 'now'))"
      },
      "constraints": [
        "UNIQUE(user_id, song_id)"
      ],
      "indexes": [
        "CREATE INDEX IF NOT EXISTS idx_user_downloads_user_id ON user_downloads(user_id);",
        "CREATE INDEX IF NOT EXISTS idx_user_downloads_song_id ON user_downloads(song_id);"
      ]
    },
    "user_footprints": {
      "columns": {
        "id": "TEXT PRIMARY KEY",
        "user_id": "TEXT NOT NULL UNIQUE",
        "footprint_json": "TEXT DEFAULT '{}'",
        "updated_at": "INTEGER DEFAULT (strftime('%s', 'now'))"
      },
      "indexes": [
        "CREATE INDEX IF NOT EXISTS idx_user_footprints_user_id ON user_footprints(user_id);"
      ]
    },
    "user_settings": {
      "columns": {
        "id": "TEXT PRIMARY KEY",
        "user_id": "TEXT NOT NULL UNIQUE",
        "settings_json": "TEXT DEFAULT '{}'",
        "updated_at": "INTEGER DEFAULT (strftime('%s', 'now'))"
      },
      "indexes": [
        "CREATE INDEX IF NOT EXISTS idx_user_settings_user_id ON user_settings(user_id);"
      ]
    },
    "followers": {
      "columns": {
        "id": "TEXT PRIMARY KEY",
        "user_id": "TEXT NOT NULL",
        "follower_id": "TEXT NOT NULL",
        "follower_username": "TEXT DEFAULT ''",
        "follower_display_name": "TEXT DEFAULT ''",
        "follower_avatar_url": "TEXT DEFAULT ''",
        "role": "TEXT DEFAULT 'user'",
        "type": "TEXT DEFAULT 'user'",
        "uid": "TEXT DEFAULT ''",
        "worker_url": "TEXT DEFAULT ''",
        "created_at": "INTEGER DEFAULT (strftime('%s', 'now'))"
      },
      "constraints": [
        "UNIQUE(user_id, follower_id)"
      ],
      "indexes": [
        "CREATE INDEX IF NOT EXISTS idx_followers_user_id ON followers(user_id);",
        "CREATE INDEX IF NOT EXISTS idx_followers_follower_id ON followers(follower_id);"
      ]
    },
    "following": {
      "columns": {
        "id": "TEXT PRIMARY KEY",
        "user_id": "TEXT NOT NULL",
        "following_id": "TEXT NOT NULL",
        "following_username": "TEXT DEFAULT ''",
        "following_display_name": "TEXT DEFAULT ''",
        "following_avatar_url": "TEXT DEFAULT ''",
        "role": "TEXT DEFAULT 'user'",
        "type": "TEXT DEFAULT 'user'",
        "uid": "TEXT DEFAULT ''",
        "worker_url": "TEXT DEFAULT ''",
        "created_at": "INTEGER DEFAULT (strftime('%s', 'now'))"
      },
      "constraints": [
        "UNIQUE(user_id, following_id)"
      ],
      "indexes": [
        "CREATE INDEX IF NOT EXISTS idx_following_user_id ON following(user_id);",
        "CREATE INDEX IF NOT EXISTS idx_following_following_id ON following(following_id);"
      ]
    },
    "user_presence": {
      "columns": {
        "id": "TEXT PRIMARY KEY",
        "user_id": "TEXT NOT NULL",
        "username": "TEXT DEFAULT ''",
        "is_online": "INTEGER DEFAULT 1",
        "is_playing": "INTEGER DEFAULT 0",
        "song_id": "TEXT DEFAULT ''",
        "title": "TEXT DEFAULT ''",
        "artist": "TEXT DEFAULT ''",
        "album": "TEXT DEFAULT ''",
        "art_url": "TEXT DEFAULT ''",
        "duration_ms": "INTEGER DEFAULT 0",
        "position_ms": "INTEGER DEFAULT 0",
        "updated_at": "INTEGER DEFAULT (strftime('%s', 'now'))"
      },
      "constraints": [
        "UNIQUE(user_id)"
      ],
      "indexes": [
        "CREATE INDEX IF NOT EXISTS idx_user_presence_user_id ON user_presence(user_id);"
      ]
    },
    "playback_sessions": {
      "columns": {
        "user_id": "TEXT PRIMARY KEY",
        "session_data": "TEXT NOT NULL",
        "updated_at": "INTEGER DEFAULT (strftime('%s', 'now'))"
      },
      "indexes": [
        "CREATE INDEX IF NOT EXISTS idx_playback_sessions_updated_at ON playback_sessions(updated_at DESC);"
      ]
    }
  }
}